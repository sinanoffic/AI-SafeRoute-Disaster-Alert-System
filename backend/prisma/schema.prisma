generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Shelter {
  id        Int      @id @default(autoincrement())
  name      String
  type      String
  lat       Float
  lng       Float
  capacity  Int
  isActive  Boolean  @default(true)
}

model SOSAlert {
  id            Int      @id @default(autoincrement())
  user          String
  lat           Float
  lng           Float
  riskLevel     String
  priorityLabel String
  priorityScore Int
  timestamp     DateTime @default(now())
  status        String   @default("Active")
}
